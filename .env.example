# DVD Tivat - browser configuration.
#
# Copy this file to `.env.local` and fill in the three public values. The first
# two come from Supabase Project Settings -> API; the public VAPID key must match
# the server-side private key. `.env.local` is git-ignored; this file is tracked
# and must keep placeholders only.
#
#   Project URL     -> VITE_SUPABASE_URL
#   Publishable key -> VITE_SUPABASE_PUBLISHABLE_KEY   (starts with sb_publishable_)
#
# The publishable key is PUBLIC by design. It is compiled into the browser
# bundle of every Supabase application and grants nothing on its own: the
# anonymous database role holds no table privilege and no executable function in
# this schema.
# The VAPID public key is also public by design. Its private counterpart belongs
# only in the Edge Function secret store.
#
# The SECRET key (sb_secret_...) is a different thing and must NEVER appear:
# not here, not in `.env.local`, not in any variable whose name starts with
# VITE_ (Vite inlines those into the bundle, so a secret in one is published to
# every visitor), and not in any tracked file. The browser application never
# needs it; the Web Push Edge Function receives its server credential only from
# the platform's protected secret store.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
VITE_WEB_PUSH_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY

# Enable only after completing docs/ACCOUNT_RECOVERY.md on the target project.
VITE_PASSWORD_RESET_ENABLED=false

# Enable only after migration 202609200013 has been applied and verified on
# the hosted project. With false, DVD role controls keep working and the SZS
# selector stays read-only.
VITE_MULTI_SERVICE_ADMIN_ENABLED=false
